{
  "name": "disparoy",
  "version": "0.1.0",
  "private": true,
  "description": "Painel web do sistema interno de disparo de mensagens via WhatsApp",
  "workspaces": [
    "shared",
    "frontend"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @disparoy/frontend",
    "build": "npm run build -w @disparoy/dominio && npm run build -w @disparoy/frontend",
    "lint": "eslint .",
    "compartilhado:gravar": "node scripts/hash-compartilhado.mjs --gravar",
    "compartilhado:verificar": "node scripts/hash-compartilhado.mjs --verificar",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0"
  },
  "engines": {
    "node": "22.x"
  }
}
